# Copy to .env and fill in. Never commit .env.

# Deployment mode: local_live | local_offline | public_demo (default: local_offline)
APP_MODE=local_offline

# Provider credentials (leave blank to run without them)
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Models
JEV_MODEL=jev-latest
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_ANALYST_MODEL=gpt-5.4-mini

# Database (default: sqlite:///<repo>/data/harm_detection.sqlite)
# DATABASE_URL=sqlite:////absolute/path/to/harm_detection.sqlite

# Local GPT analysis spending target (estimate, not a provider billing cap)
MAX_ANALYST_BUDGET_USD=5.00

# Maximum comment length accepted for inference
MAX_TEXT_LENGTH=5000
